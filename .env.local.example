# Supabase — Project Settings > API
# Public: safe to expose to the browser (protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Secret: server-only. Bypasses RLS entirely — never import into a client
# component or expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Project ref (e.g. "abcdefghijklmnop") — used by the Supabase CLI for
# `supabase link`, `supabase db push`, `pnpm db:types`, etc.
SUPABASE_PROJECT_REF=your-project-ref-here

# Used only by `pnpm bootstrap` to create the first club + owner member.
# Defaults to "Demo Club" / "demo-club" if unset.
BOOTSTRAP_CLUB_NAME=Demo Club
BOOTSTRAP_CLUB_SLUG=demo-club
